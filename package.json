{
  "name": "dsh-coco",
  "version": "1.3.0-coco.1",
  "description": "DSH-COCO — DeepSeek Harness 插件：提示词注入、补丁式兼容层、红队演练台。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./hooks": "./lib/hooks/index.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-coco": "bin/dsh-coco.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "tools",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "PROVENANCE.md",
    "LICENSE",
    "PUBLIC-KEY.txt",
    "prompts",
    "llms.txt"
  ],
  "scripts": {
    "dryrun": "node tools/dryrun.mjs",
    "test": "node tools/test/run-all.mjs",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "locate": "node tools/test/patch-locate.test.mjs",
    "manifest": "node scripts/manifest.mjs",
    "sign": "node scripts/sign.mjs",
    "release": "node scripts/manifest.mjs && node scripts/sign.mjs && node scripts/verify.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuJunZhiXue/dsh-coco.git"
  },
  "homepage": "https://github.com/muye/dsh-coco#readme",
  "bugs": {
    "url": "https://github.com/YuJunZhiXue/dsh-coco/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/YuJunZhiXue/dsh-coco/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/YuJunZhiXue/dsh-coco/archive/refs/heads/master.zip",
      "git": "https://github.com/YuJunZhiXue/dsh-coco.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2"
}
